  "nodes": [
    {
      "parameters": {
        "path": "thermoduct-upload",
        "formTitle": "Foto's uploaden",
        "formDescription": "Upload foto's voor deze collector",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Foto's",
              "fieldType": "file",
              "acceptFileTypes": ".jpg,.jpeg,.png,.heic,.webp",
              "multipleFiles": true,
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "u1p2l3o4-0001-4000-8000-000000000001",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "c939dab0-c13d-4f51-95b7-50ddc4068880"
    },
    {
      "parameters": {
        "jsCode": "const NAS_BASE_PATH = '/home/node/n8n-files/projects';\n\nconst input = $input.first().json;\nconst projectId = input.formQueryParameters?.project_id || '';\nconst folderPath = input.formQueryParameters?.folder_path || '';\n\nif (!projectId || !folderPath) {\n  throw new Error('Geen project_id of folder_path opgegeven.');\n}\n\n// Beveiligingscheck\nif (folderPath.includes('..') || folderPath.startsWith('/')) {\n  throw new Error('Ongeldig pad.');\n}\n\nconst targetDir = `${NAS_BASE_PATH}/${projectId}/${folderPath}`;\n\nreturn [{ json: { projectId, folderPath, targetDir } }];"
      },
      "id": "u1p2l3o4-0001-4000-8000-000000000002",
      "name": "Setup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "command": "={{ `mkdir -p '${$json.targetDir}'` }}",
        "options": {}
      },
      "id": "u1p2l3o4-0001-4000-8000-000000000003",
      "name": "Create Dir",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Splits elk geüpload bestand in een apart item met binary data\nconst setup = $('Setup').first().json;\nconst formItem = $('Form Trigger').first();\nconst binaries = formItem.binary || {};\nconst targetDir = setup.targetDir;\n\nconst items = [];\n\nfor (const [key, fileInfo] of Object.entries(binaries)) {\n  if (fileInfo.fileName) {\n    items.push({\n      json: { targetDir, fileName: fileInfo.fileName },\n      binary: { file: formItem.binary[key] }\n    });\n  }\n}\n\nif (items.length === 0) {\n  throw new Error('Geen bestanden gevonden in upload.');\n}\n\nreturn items;"
      },
      "id": "u1p2l3o4-0001-4000-8000-000000000004",
      "name": "Prep Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.targetDir + '/' + $json.fileName }}",
        "dataPropertyName": "file",
        "options": {}
      },
      "id": "u1p2l3o4-0001-4000-8000-000000000005",
      "name": "Save Files",
      "type": "n8n-nodes-base.readWriteFile",
