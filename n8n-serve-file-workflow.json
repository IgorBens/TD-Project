      "parameters": {
        "jsCode": "const NAS_BASE_PATH = '/home/node/n8n-files/projects';\n\nconst input = $input.first().json;\nconst projectId = input.query?.project_id || '';\nconst folderPath = input.query?.folder_path || '';\nconst fileName = input.query?.file_name || '';\n\nif (!projectId || !folderPath || !fileName) {\n  throw new Error('Missende parameters.');\n}\n\nif (folderPath.includes('..') || folderPath.startsWith('/') || fileName.includes('..') || fileName.includes('/')) {\n  throw new Error('Ongeldig pad.');\n}\n\nconst filePath = `${NAS_BASE_PATH}/${projectId}/${folderPath}/${fileName}`;\n\nreturn [{ json: { filePath, fileName } }];"
      },
      "id": "sf1a2b3c-0001-4000-8000-000000000002",
      "name": "Setup",
