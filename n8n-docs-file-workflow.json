{
  "name": "Thermoduct - Docs File Serve",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "thermoduct-docs-file",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "d0c5-0004-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "thermoduct-docs-file"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst projectId = String(input.query?.project_id || '').replace(/[^a-zA-Z0-9_-]/g, '');\nconst subPath = String(input.query?.path || '').replace(/\\.\\./g, '').replace(/^\\//,'');\nconst fileName = String(input.query?.file || '').replace(/\\.\\./g, '').replace(/[\\/]/g, '').replace(/[^a-zA-Z0-9._-]/g, '_');\n\nif (!projectId || !subPath || !fileName) {\n  throw new Error('project_id, path en file zijn verplicht.');\n}\n\nconst basePath = '/home/node/n8n-files/projects';\nconst fullPath = `${basePath}/${projectId}/${subPath}/${fileName}`;\n\nreturn [{ json: { fullPath, fileName } }];"
      },
      "id": "d0c5-0004-4000-8000-000000000002",
      "name": "Build Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "fileName": "={{ $json.fullPath }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "d0c5-0004-4000-8000-000000000003",
      "name": "Read File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseBinaryPropertyName": "data",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Cache-Control", "value": "public, max-age=3600" }
            ]
          }
        }
      },
      "id": "d0c5-0004-4000-8000-000000000004",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Build Path", "type": "main", "index": 0 }]
      ]
    },
    "Build Path": {
      "main": [
        [{ "node": "Read File", "type": "main", "index": 0 }]
      ]
    },
    "Read File": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
